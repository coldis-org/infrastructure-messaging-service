/*
 * Two realms on purpose, so system accounts and humans cannot reach each other's surface:
 *
 *   activemq -> messaging protocols (the acceptors). Backed by the properties files that
 *               artemis_add_user builds from ARTEMIS_USERNAME/ARTEMIS_PASSWORD and
 *               etc/extension/artemis-users.properties. These accounts get
 *               ARTEMIS_SERVICE_ROLE, which can send/consume but not manage the broker.
 *   console  -> web console and its Jolokia endpoint only (-Dhawtio.realm=console in
 *               artemis.profile). LDAP-backed humans, who get ARTEMIS_ADMIN_ROLE.
 *
 * There is deliberately no properties fallback in the console realm: a system account must
 * not be able to log into the UI. Consequence: with the LDAP_* variables unset nobody can
 * log into the console at all (fail closed).
 *
 * ${...} placeholders are expanded by artemis_init at startup. JAAS itself only expands
 * system properties, not environment variables, hence the envsubst pass.
 *
 * On the timeouts: JNDI waits forever by default, so leaving them unset is not a neutral choice. A
 * directory that accepts connections but stops answering blocks each login attempt for minutes
 * (measured at ~118s per attempt), holding a Jetty thread for the duration.
 *
 * Only C-style comments work in this file - a '#' inside a module entry makes JAAS fail with
 * "Configuration Error" and every console login returns 503.
 *
 * LDAP_HOST is "host:port", composed by artemis_init from the LDAP_URI and LDAP_PORT the orchestrator
 * template renders, the same way the other services build it. Both parts can change at runtime:
 * artemis_update_conn rewrites connectionURL here and the JaasRefreshAgent reloads it in-process, so
 * a directory that moves to a new address and port is picked up without restarting the broker.
 *
 * Do not expect editing this file to take effect on its own. JAAS parses it once, at JVM startup, and
 * neither reloadConfigurationFile, restartEmbeddedWebServer, clearAuthenticationCache nor
 * clearAuthorizationCache make it read again - all four measured. The agent is what closes that gap.
 *
 * A stale address only costs the console anyway: the messaging protocols authenticate in the
 * 'activemq' realm and the health check runs over CORE, so neither is affected while the directory
 * is unreachable.
 */

activemq {
    org.apache.activemq.artemis.spi.core.security.jaas.PropertiesLoginModule required
        debug=false
        reload=true
        org.apache.activemq.jaas.properties.user="artemis-users.properties"
        org.apache.activemq.jaas.properties.role="artemis-roles.properties"
        ;
};

console {
    /*
     * Break glass, disabled at rest. Its property files are created empty, so no user matches and the
     * LDAP module below decides every login on its own. artemis_breakglass --enable fills them in and
     * 'reload=true' makes this module pick that up with no restart; --disable empties them again.
     *
     * 'sufficient' means a match here returns immediately and the directory is never consulted, which
     * is the entire point: it has to work while LDAP is down.
     */
    org.apache.activemq.artemis.spi.core.security.jaas.PropertiesLoginModule sufficient
        debug=false
        reload=true
        org.apache.activemq.jaas.properties.user="breakglass-users.properties"
        org.apache.activemq.jaas.properties.role="breakglass-roles.properties"
        ;

    org.apache.activemq.artemis.spi.core.security.jaas.LDAPLoginModule required
        debug=${LDAP_DEBUG}
        initialContextFactory=com.sun.jndi.ldap.LdapCtxFactory
        connectionURL="ldap://${LDAP_HOST}"
        connectionUsername="${LDAP_USER}"
        connectionPassword="${LDAP_PASSWORD}"
        connectionProtocol=""
        authentication=simple
        connectionTimeout="${LDAP_CONNECTION_TIMEOUT}"
        readTimeout="${LDAP_READ_TIMEOUT}"
        userBase="${LDAP_USERS}"
        userSearchMatching="(cn={0})"
        userSearchSubtree=true
        roleBase="${LDAP_GROUPS}"
        roleName=cn
        roleSearchMatching="(memberUid={1})"
        roleSearchSubtree=true
        ;
};
